<mah:MetroWindow x:Class="SwingAdviser.Presentation.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="{Binding Title}"
                 Width="1920"
                 Height="1080"
                 MinWidth="1100"
                 MinHeight="700"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 WindowStartupLocation="CenterScreen">
    <mah:MetroWindow.Resources>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NoticeBorder" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
        </Style>
        <Style x:Key="ProgressCard" TargetType="Border" BasedOn="{StaticResource NoticeBorder}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray6}" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource NoticeBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="日本株スイング判断支援" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" Text="{Binding SafetyNotice}" />
                </StackPanel>
                <Border Grid.Column="1" Margin="16,0,0,0" Padding="8,4" CornerRadius="3"
                        Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1">
                    <TextBlock Foreground="#664D03" FontWeight="SemiBold" Text="UIモック — 表示内容はダミーデータ" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ProgressCard}" BorderBrush="#FF6F9D75">
                <StackPanel>
                    <DockPanel>
                        <TextBlock FontWeight="SemiBold" Text="日次分析更新" />
                        <TextBlock DockPanel.Dock="Right" Foreground="#FF256029" FontWeight="SemiBold"
                                   Text="{Binding DailyUpdateProgress.Status}" />
                    </DockPanel>
                    <ProgressBar Margin="0,8,0,0" Height="14" Minimum="0" Maximum="100"
                                 Value="{Binding DailyUpdateProgress.ProgressPercent}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}"
                               Text="{Binding DailyUpdateProgress.Summary}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}"
                               Text="{Binding DailyUpdateProgress.Detail}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource ProgressCard}" BorderBrush="#FF4D8BC8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock FontWeight="SemiBold" Text="AIチェック" />
                        <TextBlock DockPanel.Dock="Right" Foreground="#FF2166A5" FontWeight="SemiBold"
                                   Text="{Binding AiQueueProgress.Status}" />
                    </DockPanel>
                    <ProgressBar Margin="0,8,0,0" Height="14" Minimum="0" Maximum="100"
                                 IsIndeterminate="{Binding AiQueueProgress.IsIndeterminate}"
                                 Value="{Binding AiQueueProgress.ProgressPercent}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}"
                               Text="{Binding AiQueueProgress.Summary}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}"
                               Text="{Binding AiQueueProgress.Detail}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="12,0,0,0" Padding="12" CornerRadius="4"
                    Background="#FFE8F3FF" BorderBrush="#FF9DC8F0" BorderThickness="1" VerticalAlignment="Stretch">
                <TextBlock Width="230" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="#FF164B7A" FontWeight="SemiBold"
                           Text="分析更新は完了しています。AIチェックはバックグラウンドで継続中です。候補・保有の表示はAI完了を待ちません。" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,8" Style="{StaticResource MutedText}" Text="{Binding MockStatus}" />

        <TabControl Grid.Row="3">
            <TabItem Header="候補">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CandidateGrid" AutoGenerateColumns="False" FrozenColumnCount="3" IsReadOnly="True" SelectionMode="Extended"
                              CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding Candidates}" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="コード" />
                            <DataGridTextColumn Width="170" Binding="{Binding Name}" Header="銘柄名" />
                            <DataGridTextColumn Width="95" Binding="{Binding Direction}" Header="Long/Short" />
                            <DataGridTextColumn Width="65" Binding="{Binding Score}" Header="スコア" />
                            <DataGridTextColumn Width="300" Binding="{Binding PrimaryReason}" Header="主な判定理由" />
                            <DataGridTextColumn Width="115" Binding="{Binding AiStatus}" Header="AI状態" />
                            <DataGridTextColumn Width="90" Binding="{Binding AiVerdict}" Header="AI Verdict" />
                            <DataGridTextColumn Width="135" Binding="{Binding AiVerdictAlignment}" Header="候補方向との関係" />
                            <DataGridTemplateColumn Width="220" Header="AIチェック">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Padding="8,3" Click="QueueCandidateAiCheck" Content="実行" IsEnabled="{Binding CanQueueAiCheck}" ToolTip="{Binding AiOperationHint}" />
                                            <Button Margin="6,0,0,0" Padding="8,3" Click="CancelOrRetryAiCheck" Content="{Binding AiQueueActionLabel}" IsEnabled="{Binding CanChangeAiQueue}" ToolTip="{Binding AiOperationHint}" />
                                            <Button Margin="6,0,0,0" Padding="8,3" Click="ShowAiCheckDetail" Content="詳細" IsEnabled="{Binding CanShowAiDetail}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="135" Header="手動約定登録">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,3" Click="ShowCandidateRegistrationPreview"
                                        Content="約定を手入力" IsEnabled="{Binding CanRegisterManualExecution}"
                                        ToolTip="{Binding ManualRegistrationHint}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Margin="18,4" Padding="10" Background="{DynamicResource MahApps.Brushes.Gray9}" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="候補の根拠" />
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding EvaluationBarDate, StringFormat=判定基準バー日: {0}}" />
                                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding EntryType, StringFormat=Entry種別: {0}}" />
                                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Strategy, StringFormat=適用戦略: {0}}" />
                                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Confidence, StringFormat=信頼度: {0}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock FontWeight="SemiBold" Text="AIチェックの状態・結果" />
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding AiStatusDescription}" />
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding AiSummary, TargetNullValue=AI結果はまだありません。}" />
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" Text="AI Verdict は市場見通しであり、売買推奨ではありません。情報不足はNeutral（中立）とは区別して表示します。" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <Expander Grid.Row="1" Margin="0,8,0,0" IsExpanded="True" Header="対象外・データ不足（ダミー 2件）">
                        <DataGrid Margin="0,4,0,0" MaxHeight="145" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding ExcludedCandidates}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="90" Binding="{Binding Code}" Header="コード" />
                                <DataGridTextColumn Width="190" Binding="{Binding Name}" Header="銘柄名" />
                                <DataGridTextColumn Width="175" Binding="{Binding DataStatus}" Header="データ状態" />
                                <DataGridTextColumn Width="155" Binding="{Binding History}" Header="保有 / 必要履歴本数" />
                                <DataGridTextColumn Width="*" Binding="{Binding ExclusionReason}" Header="除外理由・確認事項" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button HorizontalAlignment="Left" Padding="10,4" Click="QueueSelectedCandidateAiChecks" Content="選択した候補をAIチェック" ToolTip="選択した候補をまとめて永続キューへ追加します。注文・約定は行いません。" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding CandidateCaption}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedText}" Text="行を選択すると、候補根拠とAI結果の詳細を表示します。AI Verdict は売買推奨ではありません。Long + Bullish / Short + Bearish は候補方向と整合、逆の組合せは候補方向と逆、Neutral は中立として表示します。情報不足はNeutralへ変換しません。" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedText}" Text="対象外は条件不一致と混同せず、履歴不足・データ不正・point-in-time 非保証などの理由を表示します。" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="保有">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid AutoGenerateColumns="False" FrozenColumnCount="3" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding Positions}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="コード" />
                            <DataGridTextColumn Width="150" Binding="{Binding Name}" Header="銘柄名" />
                            <DataGridTextColumn Width="95" Binding="{Binding Direction}" Header="Long/Short" />
                            <DataGridTextColumn Width="90" Binding="{Binding Quantity}" Header="現在数量" />
                            <DataGridTextColumn Width="150" Binding="{Binding Strategy}" Header="適用戦略" />
                            <DataGridTextColumn Width="120" Binding="{Binding ExitDecision}" Header="決済判定" />
                            <DataGridTextColumn Width="110" Binding="{Binding EvaluationDate}" Header="判定日" />
                            <DataGridTextColumn Width="230" Binding="{Binding DecisionReason}" Header="判定理由" />
                            <DataGridTextColumn Width="105" Binding="{Binding StopCandidate}" Header="損切候補" />
                            <DataGridTextColumn Width="105" Binding="{Binding TakeProfitCandidate}" Header="利確候補" />
                            <DataGridTextColumn Width="200" Binding="{Binding HoldReason}" Header="HOLD理由" />
                            <DataGridTextColumn Width="170" Binding="{Binding RepaymentTerm}" Header="返済期限・残営業日" />
                            <DataGridTextColumn Width="115" Binding="{Binding ConfirmedCost}" Header="確定コスト" />
                            <DataGridTextColumn Width="115" Binding="{Binding EstimatedCost}" Header="見積コスト" />
                            <DataGridTextColumn Width="115" Binding="{Binding PriceProfitAndLoss}" Header="価格損益" />
                            <DataGridTextColumn Width="135" Binding="{Binding NetReferenceProfitAndLoss}" Header="ネット参考損益" />
                            <DataGridTextColumn Width="175" Binding="{Binding ReconciliationStatus}" Header="要照合状態" />
                            <DataGridTemplateColumn Width="155" Header="手動決済登録">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,3" Click="ShowPositionRegistrationPreview"
                                                Content="約定を手入力"
                                                ToolTip="対象ポジションの決済約定を手入力します。価格・日時・株数・lot配分は自動入力しません。" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource MutedText}"
                               Text="損切・利確・決済判定は判断支援です。自動決済・自動発注は行いません。期限・コストが未確認の場合は金額を0円として表示しません。" />
                </Grid>
            </TabItem>

            <TabItem Header="履歴">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              ItemsSource="{Binding Executions}" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="コード" />
                            <DataGridTextColumn Width="160" Binding="{Binding Name}" Header="銘柄名" />
                            <DataGridTextColumn Width="95" Binding="{Binding Direction}" Header="Long/Short" />
                            <DataGridTextColumn Width="80" Binding="{Binding ExecutionRole}" Header="新規/決済" />
                            <DataGridTextColumn Width="165" Binding="{Binding RegistrationSource}" Header="登録元" />
                            <DataGridTextColumn Width="145" Binding="{Binding ExecutedAt}" Header="約定日時" />
                            <DataGridTextColumn Width="100" Binding="{Binding Price}" Header="約定価格" />
                            <DataGridTextColumn Width="90" Binding="{Binding Quantity}" Header="株数" />
                            <DataGridTextColumn Width="135" Binding="{Binding RevisionStatus}" Header="訂正操作・revision" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Margin="18,4" Padding="8" Background="{DynamicResource MahApps.Brushes.Gray9}" CornerRadius="3">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding RevisionDetail}" />
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource MutedText}"
                               Text="約定履歴は利用者が明示的に入力・確認して登録する監査原票です。訂正は元の記録を上書きせず revision として残します。" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</mah:MetroWindow>
