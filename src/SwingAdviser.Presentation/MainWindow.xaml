<mah:MetroWindow x:Class="SwingAdviser.Presentation.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:local="clr-namespace:SwingAdviser.Presentation"
                 Title="{Binding Title}"
                 Width="1920"
                 Height="1080"
                 MinWidth="1100"
                 MinHeight="700"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 WindowStartupLocation="CenterScreen">
    <mah:MetroWindow.Resources>
        <local:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NoticeBorder" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Padding="12,5" Click="RunDailyUpdate" Content="日次分析を更新" IsEnabled="{Binding IsUpdateRunning, Converter={StaticResource BooleanNegationConverter}}" ToolTip="外部データ取得、分析、候補生成、保有再評価を開始します。注文・約定は行いません。" />
                <Button Margin="8,0,0,0" Padding="12,5" Click="CancelDailyUpdate" Content="更新を中止" IsEnabled="{Binding IsUpdateRunning}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Text="{Binding OpenPositionProfitAndLoss}" />
                <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0" Style="{StaticResource MutedText}" Text="最新確定終値ベース。ネット参考損益は信用コストを確認できた場合のみ表示" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="{Binding DailyUpdateProgress.Status}" />
                <TextBlock Margin="8,0,0,0" Style="{StaticResource MutedText}" Text="{Binding DailyUpdateProgress.OverallSummary}" />
                <TextBlock Margin="20,0,0,0" FontWeight="SemiBold" Text="AI" />
                <TextBlock Margin="8,0,0,0" Style="{StaticResource MutedText}" Text="{Binding AiQueueProgress.Summary}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,8" Style="{StaticResource MutedText}" Text="候補・保有・履歴は保存済みの実データです。候補とAI結果は参考情報であり、注文・約定を生成しません。" />

        <TabControl Grid.Row="2">
            <TabItem Header="候補">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <DataGrid AutoGenerateColumns="False" FrozenColumnCount="3" IsReadOnly="True" SelectionMode="Single"
                              CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding Candidates}"
                              SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                              MouseDoubleClick="OpenYahooFinanceChart"
                              ToolTip="行をダブルクリックするとYahoo!ファイナンスのチャートを開きます。">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="コード" />
                            <DataGridTextColumn Width="170" Binding="{Binding Name}" Header="銘柄名" />
                            <DataGridTemplateColumn Width="95" Header="Long/Short">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="7,3" CornerRadius="3" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFEDEDED" />
                                                    <Setter Property="BorderBrush" Value="#FF777777" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Long">
                                                            <Setter Property="Background" Value="#FFE2F3E6" />
                                                            <Setter Property="BorderBrush" Value="#FF39804A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Short">
                                                            <Setter Property="Background" Value="#FFFCE6E6" />
                                                            <Setter Property="BorderBrush" Value="#FFB44040" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Direction}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF333333" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Direction}" Value="Long"><Setter Property="Foreground" Value="#FF1B5E2A" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Direction}" Value="Short"><Setter Property="Foreground" Value="#FF9B2525" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="65" Binding="{Binding Score}" Header="スコア" />
                            <DataGridTextColumn Width="115" Binding="{Binding LatestClose}" Header="最終確定終値">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="300" Binding="{Binding PrimaryReason}" Header="主な判定理由" />
                            <DataGridTextColumn Width="115" Binding="{Binding AiStatus}" Header="AI状態" />
                            <DataGridTextColumn Width="90" Binding="{Binding AiVerdict}" Header="AI Verdict" />
                            <DataGridTextColumn Width="135" Binding="{Binding AiVerdictAlignment}" Header="候補方向との関係" />
                            <DataGridTemplateColumn Width="220" Header="AIチェック">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Padding="8,3" Click="QueueCandidateAiCheck" Content="実行" IsEnabled="{Binding CanQueueAiCheck}" ToolTip="{Binding AiOperationHint}" />
                                            <Button Margin="6,0,0,0" Padding="8,3" Click="CancelOrRetryAiCheck" Content="{Binding AiQueueActionLabel}" IsEnabled="{Binding CanChangeAiQueue}" ToolTip="{Binding AiOperationHint}" />
                                            <Button Margin="6,0,0,0" Padding="8,3" Click="ShowAiCheckDetail" Content="詳細" IsEnabled="{Binding CanShowAiDetail}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="135" Header="手動約定登録">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,3" Click="ShowCandidateRegistrationPreview"
                                        Content="約定を手入力" IsEnabled="{Binding CanRegisterManualExecution}"
                                        ToolTip="{Binding ManualRegistrationHint}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Margin="0,8,0,0" Padding="12" Background="{DynamicResource MahApps.Brushes.Gray9}" CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock FontWeight="SemiBold" FontSize="16" Text="候補詳細" />
                            </DockPanel>
                            <ContentControl Grid.Row="1" Margin="0,10,0,0" Content="{Binding SelectedCandidate}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="候補の根拠" />
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Code, StringFormat=コード: {0}}" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Name, StringFormat=銘柄名: {0}}" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding EvaluationBarDate, StringFormat=判定基準バー日: {0}}" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding EntryType, StringFormat=Entry種別: {0}}" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Strategy, StringFormat=適用戦略: {0}}" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Confidence, StringFormat=信頼度: {0}}" />
                                                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="主な判定理由" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding PrimaryReason}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock FontWeight="SemiBold" Text="AIチェックの状態・結果" />
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding AiStatusDescription}" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding AiVerdict, StringFormat=Verdict: {0}, TargetNullValue=Verdict: 未取得}" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding AiVerdictAlignment, TargetNullValue=候補方向との関係は未取得です。}" />
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding AiSummary, TargetNullValue=AI結果はまだありません。}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="保有">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid AutoGenerateColumns="False" FrozenColumnCount="3" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding Positions}"
                              MouseDoubleClick="OpenYahooFinanceChart"
                              ToolTip="行をダブルクリックするとYahoo!ファイナンスのチャートを開きます。">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="コード" />
                            <DataGridTextColumn Width="150" Binding="{Binding Name}" Header="銘柄名" />
                            <DataGridTextColumn Width="95" Binding="{Binding Direction}" Header="Long/Short" />
                            <DataGridTextColumn Width="90" Binding="{Binding Quantity}" Header="現在数量" />
                            <DataGridTextColumn Width="150" Binding="{Binding Strategy}" Header="適用戦略" />
                            <DataGridTextColumn Width="120" Binding="{Binding ExitDecision}" Header="決済判定" />
                            <DataGridTextColumn Width="110" Binding="{Binding EvaluationDate}" Header="判定日" />
                            <DataGridTextColumn Width="230" Binding="{Binding DecisionReason}" Header="判定理由" />
                            <DataGridTextColumn Width="105" Binding="{Binding StopCandidate}" Header="損切候補" />
                            <DataGridTextColumn Width="105" Binding="{Binding TakeProfitCandidate}" Header="利確候補" />
                            <DataGridTextColumn Width="200" Binding="{Binding HoldReason}" Header="HOLD理由" />
                            <DataGridTextColumn Width="170" Binding="{Binding RepaymentTerm}" Header="返済期限・残営業日" />
                            <DataGridTextColumn Width="115" Binding="{Binding ConfirmedCost}" Header="確定コスト" />
                            <DataGridTextColumn Width="115" Binding="{Binding EstimatedCost}" Header="見積コスト" />
                            <DataGridTextColumn Width="115" Binding="{Binding PriceProfitAndLoss}" Header="価格損益" />
                            <DataGridTextColumn Width="135" Binding="{Binding NetReferenceProfitAndLoss}" Header="ネット参考損益" />
                            <DataGridTextColumn Width="115" Binding="{Binding LatestClose}" Header="最新確定終値" />
                            <DataGridTextColumn Width="175" Binding="{Binding ReconciliationStatus}" Header="要照合状態" />
                            <DataGridTemplateColumn Width="155" Header="手動決済登録">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,3" Click="ShowPositionRegistrationPreview"
                                                Content="約定を手入力"
                                                ToolTip="対象ポジションの決済約定を手入力します。価格・日時・株数・lot配分は自動入力しません。" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource MutedText}"
                               Text="損切・利確・決済判定は判断支援です。自動決済・自動発注は行いません。期限・コストが未確認の場合は金額を0円として表示しません。" />
                </Grid>
            </TabItem>

            <TabItem Header="履歴">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              ItemsSource="{Binding Executions}" RowDetailsVisibilityMode="VisibleWhenSelected"
                              MouseDoubleClick="OpenYahooFinanceChart"
                              ToolTip="行をダブルクリックするとYahoo!ファイナンスのチャートを開きます。">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70" Binding="{Binding Code}" Header="コード" />
                            <DataGridTextColumn Width="160" Binding="{Binding Name}" Header="銘柄名" />
                            <DataGridTextColumn Width="95" Binding="{Binding Direction}" Header="Long/Short" />
                            <DataGridTextColumn Width="80" Binding="{Binding ExecutionRole}" Header="新規/決済" />
                            <DataGridTextColumn Width="165" Binding="{Binding RegistrationSource}" Header="登録元" />
                            <DataGridTextColumn Width="145" Binding="{Binding ExecutedAt}" Header="約定日時" />
                            <DataGridTextColumn Width="100" Binding="{Binding Price}" Header="約定価格" />
                            <DataGridTextColumn Width="90" Binding="{Binding Quantity}" Header="株数" />
                            <DataGridTextColumn Width="135" Binding="{Binding RevisionStatus}" Header="訂正操作・revision" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Margin="18,4" Padding="8" Background="{DynamicResource MahApps.Brushes.Gray9}" CornerRadius="3">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding RevisionDetail}" />
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource MutedText}"
                               Text="約定履歴は利用者が明示的に入力・確認して登録する監査原票です。訂正は元の記録を上書きせず revision として残します。" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</mah:MetroWindow>
