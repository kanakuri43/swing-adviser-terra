<mah:MetroWindow x:Class="SwingAdviser.Presentation.CandidateRegistrationPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="約定登録（手動）" Width="720" SizeToContent="Height" MinHeight="650"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="12" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="#664D03" Text="証券会社の約定通知を確認してから、すべて利用者が入力してください" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="候補から渡すのは銘柄・Long/Short・戦略の入力補助のみです。現在値、終値、サイン日時、AI判定は使用しません。保存前に内容を確認します。" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="銘柄コード" />
            <TextBox Grid.Column="1" Padding="6,4" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="方向" />
            <ComboBox Grid.Column="1" SelectedValue="{Binding Side}" SelectedValuePath="Content"><ComboBoxItem Content="Long" /><ComboBoxItem Content="Short" /></ComboBox>
        </Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="約定日時（JST）" />
            <TextBox Grid.Column="1" Padding="6,4" Text="{Binding ExecutedAtText, UpdateSourceTrigger=PropertyChanged}" ToolTip="例: 2026-08-31 10:15 +09:00" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="約定価格 / 株数" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="170" Padding="6,4" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="10,0" VerticalAlignment="Center" Text="/" /><TextBox Width="170" Padding="6,4" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        </Grid>
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="戦略キー / version" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="190" Padding="6,4" Text="{Binding StrategyKey, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="10,0" VerticalAlignment="Center" Text="/" /><TextBox Width="120" Padding="6,4" Text="{Binding StrategyVersion, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        </Grid>
        <Expander Grid.Row="6" Margin="0,14,0,0" Header="決済として登録する場合（lot 割当は必須）">
            <StackPanel Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" Text="新規建では入力不要です。決済では対象ポジション ID と、どの lot に何株を充当するかを利用者が明示入力します。FIFO 等は使用しません。" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Text="対象ポジション ID" /><TextBox Margin="12,0,0,0" Width="120" Padding="6,4" Text="{Binding ClosePositionIdText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <DataGrid Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" ItemsSource="{Binding Allocations}" Height="135">
                    <DataGrid.Columns><DataGridTextColumn Header="lot ID" Width="*" Binding="{Binding MarginLotIdText, UpdateSourceTrigger=PropertyChanged}" /><DataGridTextColumn Header="割当株数" Width="*" Binding="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" /></DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Expander>
        <TextBlock Grid.Row="7" Margin="0,12,0,0" Foreground="#B00020" TextWrapping="Wrap" Text="{Binding ValidationMessage}" />
        <StackPanel Grid.Row="8" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <CheckBox Margin="0,0,14,0" VerticalAlignment="Center" Content="証券会社の約定通知を確認しました" IsChecked="{Binding UserConfirmed}" />
            <Button Margin="0,0,8,0" Padding="12,5" Click="ConfirmAndSave" Content="内容を確認して保存" />
            <Button Padding="12,5" IsCancel="True" Content="取消" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
