<mah:MetroWindow x:Class="SwingAdviser.Presentation.CandidateRegistrationPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="約定登録（UIモック）"
                 Width="640"
                 SizeToContent="Height"
                 MinHeight="570"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="#664D03" Text="UIモック — 入力内容は保存されません" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="候補から渡すのは銘柄と Long/Short の入力補助だけです。約定日時・価格・株数は、利用者が証券会社の約定通知を確認して明示入力します。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="銘柄（入力補助）" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding CodeAndName}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="方向（入力補助）" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Direction}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="登録元" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="候補からの入力補助（手動登録）" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="約定日時（JST）" />
            <TextBox Grid.Column="1" Padding="6,4" ToolTip="Phase 6 で利用者が入力します。" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="約定価格" />
            <TextBox Grid.Column="1" Padding="6,4" ToolTip="Phase 6 で利用者が入力します。" />
        </Grid>

        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="株数" />
            <TextBox Grid.Column="1" Padding="6,4" ToolTip="Phase 6 で利用者が入力します。" />
        </Grid>

        <StackPanel Grid.Row="7" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0" Padding="12,5" IsEnabled="False" Content="保存（Phase 6で実装）" />
            <Button Padding="12,5" IsCancel="True" Content="閉じる" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
